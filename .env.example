# Copiar para .env (que esta no .gitignore). NUNCA versionar o .env.
# Nenhuma chave privada, senha de certificado ou PIN entra aqui.

DATABASE_URL=postgresql://localhost:5432/trt_extractor

# Storage: local content-addressed nas fases 0-4; s3:// a partir da fase 5.
STORAGE_URI=file://./data/blobs

# Referencia ao certificado no repositorio do SO (MSCAPI). So o thumbprint.
CREDENCIAL_ID=
CERTIFICADO_THUMBPRINT=

# SSO da PDPJ-Br (confirmado em ~/.pjeoffice-pro/pjeoffice-pro.config)
PDPJ_SSO_URL=https://sso.cloud.pje.jus.br/auth/realms/pje
PDPJ_CONSULTA_URL=https://portaldeservicos.pdpj.jus.br/consulta
PDPJ_API_BASE=https://portaldeservicos.pdpj.jus.br/api/v2

# Chave publica do DataJud (wiki do CNJ). Seed e triagem apenas -- nao e
# via de aquisicao: DataJud nao tem documentos.
DATAJUD_API_KEY=

# Observabilidade
LOG_LEVEL=INFO
PROMETHEUS_PORT=9100
